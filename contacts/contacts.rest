@local = http://localhost:3000
@render = https://cse341-node-rse7.onrender.com

### IMPORTANT
### Replace the ids below with real MongoDB ObjectIds from your own contacts collection.

@contactId = REPLACE_WITH_CONTACT_ID
@deleteId = REPLACE_WITH_CONTACT_ID_TO_DELETE

### ---------------- LOCAL TESTS ----------------

### Home
GET {{local}}/

### Swagger JSON
GET {{local}}/swagger.json

### Get all contacts
GET {{local}}/contacts

### Get one contact
GET {{local}}/contacts/{{contactId}}

### Create a contact
POST {{local}}/contacts
Content-Type: application/json

{
  "firstName": "Grace",
  "lastName": "Nabirye",
  "email": "grace.nabirye@example.com",
  "favoriteColor": "Purple",
  "birthday": "1999-04-15"
}

### Update a contact
PUT {{local}}/contacts/{{contactId}}
Content-Type: application/json

{
  "firstName": "Grace",
  "lastName": "Nabirye",
  "email": "grace.updated@example.com",
  "favoriteColor": "Green",
  "birthday": "1999-04-15"
}

### Delete a contact
DELETE {{local}}/contacts/{{deleteId}}

