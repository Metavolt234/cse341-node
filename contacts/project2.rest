@local = http://localhost:3000
@render = https://YOUR-APP.onrender.com
@contactId = REPLACE_WITH_CONTACT_ID
@projectId = REPLACE_WITH_PROJECT_ID

### HOME & DOCS
GET {{local}}/
###
GET {{local}}/swagger.json
###
GET {{local}}/api-docs

### AUTH
# Open this URL in a browser to sign in with GitHub.
GET {{local}}/auth/github
###
GET {{local}}/auth/status
###
GET {{local}}/auth/logout

### CONTACTS
GET {{local}}/contacts
###
GET {{local}}/contacts/{{contactId}}
###
# Protected: must be logged in
POST {{local}}/contacts
Content-Type: application/json

{
  "firstName": "Daniel",
  "lastName": "Kato",
  "email": "daniel.kato@example.com",
  "phone": "+256 700 333333",
  "favoriteColor": "Green",
  "birthday": "2001-08-22",
  "city": "Jinja"
}
###
# Protected: must be logged in
PUT {{local}}/contacts/{{contactId}}
Content-Type: application/json

{
  "firstName": "Daniel",
  "lastName": "Kato Updated",
  "email": "daniel.updated@example.com",
  "phone": "+256 700 333444",
  "favoriteColor": "Orange",
  "birthday": "2001-08-22",
  "city": "Jinja"
}
###
# Protected: must be logged in
DELETE {{local}}/contacts/{{contactId}}

