{
  "openapi": "3.0.3",
  "info": {
    "title": "CSE 341 Community Service Connect API",
    "version": "2.0.0",
    "description": "Week 06 API. GET, POST, PUT and DELETE are available for contacts, projects, organizations, and registrations. POST/PUT bodies are validated; all write operations require GitHub OAuth session authentication."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current deployment"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Contact records. Required: firstName, lastName, email, phone, favoriteColor, birthday (YYYY-MM-DD), city."
    },
    {
      "name": "Projects",
      "description": "Service projects. Required: name, description, category, organization, location, startDate (YYYY-MM-DD), status (planned, active, completed)."
    },
    {
      "name": "Organizations",
      "description": "Partner organizations. Required: name, description, contactEmail, phone, address."
    },
    {
      "name": "Registrations",
      "description": "Volunteer registrations. Required: projectId (MongoDB ObjectId), volunteerName, volunteerEmail, registrationDate (YYYY-MM-DD), status (registered, confirmed, cancelled, completed)."
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts",
        "responses": {
          "200": {
            "description": "Records returned."
          },
          "500": {
            "description": "Server error."
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create contact",
        "security": [
          {
            "githubOAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Contact records. Required: firstName, lastName, email, phone, favoriteColor, birthday (YYYY-MM-DD), city."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created."
          },
          "400": {
            "description": "Validation error."
          },
          "401": {
            "description": "GitHub login required."
          }
        }
      }
    },
