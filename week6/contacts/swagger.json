        "description": "Sign in in the same browser session at /auth/github. Session authentication protects write operations.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/auth/github",
            "tokenUrl": "/auth/github/callback",
            "scopes": {
              "user:email": "Read GitHub email"
            }
          }
        }
      }
    }
  }
